# 复制为 .env 后替换所有 CHANGE_ME；不要提交真实值。
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
# 密码若含 @、:、/ 等字符，需进行 URL 编码。
DATABASE_URL=postgresql://worklog:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/worklog
# 至少 32 个随机字符，例如：openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# SEC-01：生产必须为 true。设为 false 时服务在 NODE_ENV=production 下会拒绝启动。
COOKIE_SECURE=true
# SEC-01：要求反向代理透传 X-Forwarded-Proto=https，明文请求将被拒绝。
# 纯 HTTP 的验收环境可临时设为 false；此时 COOKIE_SECURE 也应为 false（Secure Cookie 在 HTTP 下无法保存）。
REQUIRE_HTTPS=true
# SEC-03：留空即关闭自助注册；确需开放时填写至少 8 位邀请码并线下发放。
REGISTRATION_INVITE_CODE=
# SEC-03：设为 true 则完全开放自助注册（无需邀请码），注册账号停用待管理员启用。与邀请码同时配置时以邀请码模式为准。
REGISTRATION_OPEN=false
# SEC-05：登录尝试与审计数据保留天数（30–3650）。
SECURITY_LOG_RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# 默认仅干跑生命周期任务；核对待处理对象及文件备份后再设 true。
ARCHIVE_LIFECYCLE_ENABLED=false
# 容器内由 compose.yaml 指向持久化卷；本地可选设置为私有目录。
# ARCHIVE_STORAGE_DIR=./data/employee-archives
