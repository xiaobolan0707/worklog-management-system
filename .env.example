# 复制为 .env 后替换所有 CHANGE_ME；不要提交真实值。
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
# 密码若含 @、:、/ 等字符，需进行 URL 编码。
DATABASE_URL=postgresql://worklog:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/worklog
# 至少 32 个随机字符，例如：openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
